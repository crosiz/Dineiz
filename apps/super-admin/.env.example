# Signing secret for super-admin session JWTs. Set a real random value in
# every real deployment — the fallback in lib/auth.ts is dev-only.
SUPERADMIN_JWT_SECRET=

# RSA private key (PKCS8 PEM) used to sign Dineiz Standalone license files
# from the "Standalone Licenses" admin page. The matching public key is
# compiled into apps/standalone (src/main/licensing/publicKey.ts) — this
# private key must NEVER be committed to the repository. Store the PEM as a
# single line with literal \n sequences (standard for most env systems,
# including Vercel) — apps/super-admin/lib/standaloneLicense.ts normalizes
# it back to real newlines before use. Leave unset to run this deployment
# without standalone license issuance (the page stays usable read-only and
# shows a clear "not configured" notice instead of failing silently).
STANDALONE_LICENSE_PRIVATE_KEY=
