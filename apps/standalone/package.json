{
  "name": "@dineiz/standalone",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "rebuild-native": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "harness:build": "tsc -p tsconfig.harness.json",
    "lint": "eslint \"**/*.ts*\"",
    "dist:win": "electron-vite build && electron-builder --win",
    "generate-icon": "node scripts/generate-icon.js"
  },
  "dependencies": {
    "@dineiz/pos-logic": "workspace:*",
    "@dineiz/ui": "workspace:*",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "@fontsource/space-mono": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.378.0",
    "material-symbols": "^0.45.10",
    "pdf-to-printer": "^5.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@dineiz/config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.5"
  }
}
