{
  "name": "swiftserve",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=!@swiftserve/rider",
    "dev:all": "turbo dev",
    "dev:local": "turbo dev --filter=api --filter=dashboard --filter=pos",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "material-symbols": "^0.45.10"
  }
}
