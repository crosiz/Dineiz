model LoyaltyCampaign {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  type       String // MULTIPLIER, BONUS
  value      Float
  condition  String? // JSON to define conditions like minSpend or specific days
  validFrom  DateTime?
  validTo    DateTime?
  isActive   Boolean   @default(true)
  usageCount Int       @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  type        PromoType @default(PERCENT)
  value       Float
  minOrder    Float? // optional minimum netAmount before discount
  maxDiscount Float? // optional cap for percent promos
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  usageLimit  Int?
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

