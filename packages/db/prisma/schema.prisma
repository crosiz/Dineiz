generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  BRANCH_MANAGER
  CASHIER
  WAITER
  CALL_CENTER_AGENT
  KITCHEN_STAFF
  RIDER
  READ_ONLY
  WORKER
  COOK
  GUARD
}

enum RegistrationSource {
  WEB
  MOBILE
  POS
}

enum SuperAdminRole {
  OWNER
  SUPPORT
  SALES
}

// -----------------------------------------------------------------------------
// CORE TENANT & ORGANIZATION MODELS
// -----------------------------------------------------------------------------

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  domain             String?            @unique // Custom domain e.g., pos.theirrestaurant.com
  logoUrl            String?
  colorPrimary       String             @default("#FF5722")
  colorSecondary     String             @default("#FF8A65")
  plan               String             @default("STARTER")
  status             String             @default("ACTIVE") // ACTIVE, TRIALING, PAST_DUE, CANCELLED, SUSPENDED
  notes              String?
  registrationSource RegistrationSource @default(WEB)
  primaryPhone       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  branches    Branch[]
  users       User[]
  categories  Category[]
  items       Item[]
  orders      Order[]
  shifts      Shift[]
  kdsStations KdsStation[]
  tables      Table[]

  // Inventory & deals
  ingredients        Ingredient[]
  recipes            Recipe[]
  stocks             Stock[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  suppliers          Supplier[]
  wastageLogs        WastageLog[]
  stockTransfers     StockTransfer[]
  stockCountSessions StockCountSession[]
  promoCodes         PromoCode[]
  combos             Combo[]
  buyXGetYDeals      BuyXGetYDeal[]

  // CRM / Loyalty
  customers                  Customer[]
  loyaltyTiers               LoyaltyTier[]
  loyaltyLedger              LoyaltyPointLedger[]
  loyaltySettings            LoyaltySettings?
  loyaltyCampaigns           LoyaltyCampaign[]
  loyaltyCategoryMultipliers LoyaltyCategoryMultiplier[]

  deliveryZones DeliveryZone[]

  riderAssignments RiderAssignment[]

  // Integrations
  aggregatorWebhookEvents    AggregatorWebhookEvent[]
  aggregatorIntegrations     AggregatorIntegration[]
  aggregatorMenuMappings     AggregatorMenuMapping[]
  zapierWebhookSubscriptions ZapierWebhookSubscription[]
  webhookEndpoints           WebhookEndpoint[]
  erpIntegration             ErpIntegration?

  // WhatsApp bot
  whatsappConfig        WhatsAppConfig?
  whatsappConversations WhatsAppConversation[]
  whatsappBlocklist     WhatsAppBlocklist[]

  // Branding
  branding TenantBranding?

  // Billing
  subscription     TenantSubscription?
  paymentHistories PaymentHistory[]

  // Super Admin Extensions
  featureOverrides TenantFeatureOverride[]
  messages         SuperAdminMessage[]
  auditLogs        AuditLog[]

  // Settings
  settings        Json?
  ZktecoDevice    ZktecoDevice[]
  VoidRequest     VoidRequest[]
  deals           Deal[]
  ScheduledReport ScheduledReport[]
  AnomalySettings AnomalySettings?
  AnomalyEvents   AnomalyEvent[]
  qrSettings      QrSettings?
}

model Branch {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  city           String?
  country        String?   @default("Pakistan")
  phone          String?
  email          String?
  operatingHours Json?
  openingTime    String? // e.g. "09:00"
  closingTime    String? // e.g. "23:00"
  colorHex       String?
  initial        String?
  imageUrl       String?
  currency       String    @default("PKR")
  timezone       String    @default("Asia/Karachi")
  taxRate        Float     @default(0)
  kdsEnabled     Boolean   @default(false)
  kotPrinter     Boolean   @default(false)
  kotAutoPrint   Boolean   @default(false)
  isActive       Boolean   @default(true)
  branchCode     String?   @unique
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users       User[]
  orders      Order[]
  shifts      Shift[]
  kdsStations KdsStation[]

  // Inventory
  stocks              Stock[]
  stockMovements      StockMovement[]
  purchaseOrders      PurchaseOrder[]
  wastageLogs         WastageLog[]
  stockCountSessions  StockCountSession[]
  transfersFrom       StockTransfer[]     @relation("TransferFromBranch")
  transfersTo         StockTransfer[]     @relation("TransferToBranch")

  // Delivery zones
  deliveryZones DeliveryZone[]

  // Floor Plan
  floorPlan FloorPlan?
  tables    Table[]

  branchMenuItems      BranchMenuItem[]
  branchMenuCategories BranchMenuCategory[]
  ZktecoDevice         ZktecoDevice[]
  VoidRequest          VoidRequest[]
  ScheduledReport      ScheduledReport[]
  aggregatorIntegrations AggregatorIntegration[]
  AnomalyEvents        AnomalyEvent[]
  whatsappConversations  WhatsAppConversation[]
}

// -----------------------------------------------------------------------------
// BETTER AUTH CORE MODELS
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  password      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Custom for Dineiz
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role         Role       @default(CASHIER)
  posPin       String? // Hashed PIN for quick POS login
  status       UserStatus @default(PENDING)
  phone        String?    @unique
  lastActiveAt DateTime?
  avatarColor  String?
  deviceTokens String[]

  sessions       Session[]
  mobileSessions MobileSession[]
  accounts       Account[]
  shifts         Shift[]
  devices        UserDevice[]
  assignedOrders Order[]         @relation("AssignedWaiter")

  // Rider-specific
  riderAssignments RiderAssignment[]

  // Settings & Security
  twoFactorEnabled        Boolean                @default(false)
  notificationPreferences Json?
  AttendancePunch         AttendancePunch[]
  StaffZktecoEnrollment   StaffZktecoEnrollment?
  VoidRequest             VoidRequest[]
  AnomalyEvents           AnomalyEvent[]
}

// -----------------------------------------------------------------------------
// MOBILE AUTH MODELS
// -----------------------------------------------------------------------------

// Removed MobileUser model

enum OtpPurpose {
  REGISTRATION
  LOGIN
  RESET_PIN
}

model OtpSession {
  id          String     @id @default(cuid())
  phone       String
  purpose     OtpPurpose
  requestedAt DateTime   @default(now())
  verifiedAt  DateTime?
  ipAddress   String?
  deviceId    String?

  @@index([phone])
}

model MobileSession {
  id           String    @id @default(cuid())
  userId       String
  token        String    @unique // Hashed JWT signature
  deviceId     String?
  deviceName   String? // e.g., "iPhone 13", "Samsung Galaxy S21"
  platform     String? // "ios" | "android"
  lastActiveAt DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// MENU MODELS
// -----------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  image       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                Item[]
  kdsRoutes            KdsStationRoute[]
  branchMenuCategories BranchMenuCategory[]
  loyaltyMultipliers   LoyaltyCategoryMultiplier[]

  @@index([tenantId])
}

model Item {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String
  description String?
  basePrice   Float
  unitType    String?  @default("Per Item")
  tags        String[]
  image       String?
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variations Variation[]
  addOns     AddOn[]
  OrderItem  OrderItem[]
  kdsRoutes  KdsStationRoute[]
  aggregatorMappings AggregatorMenuMapping[]

  // Inventory & deals
  recipes         Recipe[]
  comboItems      ComboItem[]
  bxgyBuyDeals    BuyXGetYDeal[]   @relation("BxGyBuyItem")
  bxgyGetDeals    BuyXGetYDeal[]   @relation("BxGyGetItem")
  branchMenuItems BranchMenuItem[]

  @@index([tenantId])
  @@index([categoryId])
}

model Variation {
  id        String   @id @default(cuid())
  itemId    String
  name      String // e.g., "Small", "Medium", "Large"
  price     Float // Price override or offset
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item   Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  recipe Recipe?

  @@index([itemId])
}

model AddOn {
  id        String   @id @default(cuid())
  itemId    String
  name      String // e.g., "Extra Cheese"
  price     Float // Additional cost
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// -----------------------------------------------------------------------------
// ORDER MODELS
// -----------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  IN_KITCHEN
  READY
  COMPLETED
  CANCELLED
}

enum DeliveryAssignmentStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  COMPLETED
  FAILED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderSource {
  POS
  QR_CODE
  KIOSK
  FOODPANDA
  CAREEM
  TALABAT
  WHATSAPP
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  SPLIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  tenantId    String
  branchId    String
  orderNumber String // e.g., ORD-1001
  tokenNumber String? // e.g., A-12
  shiftId     String? // The shift this order was placed during
  status      OrderStatus @default(PENDING)
  type        OrderType   @default(DINE_IN)
  source      OrderSource @default(POS)

  totalAmount    Float
  discountAmount Float @default(0)
  taxAmount      Float @default(0)
  netAmount      Float

  // Dual-tax snapshot â€” rates stored at time of order creation for historical accuracy
  cashTaxRate     Float? // Snapshot of branding.cashTaxRate at time of order
  cardTaxRate     Float? // Snapshot of branding.cardTaxRate at time of order
  appliedTaxRate  Float? // Actual rate used after payment method resolved
  appliedTaxLabel String? // e.g. "GST (Cash 5%)"

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Delivery
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryEtaSec  Int?
  deliveryZoneId  String?

  // Dine-in Table
  tableId String?

  cashierId  String?
  customerId String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift        Shift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  table        Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  assignedWaiterId   String?
  assignedWaiterName String?
  assignedAt         DateTime?
  assignedWaiter     User?     @relation("AssignedWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)

  riderAssignment RiderAssignment?

  items       OrderItem[]
  payments    Payment[]
  VoidRequest VoidRequest[]
  orderDeals  OrderDeal[]

  @@index([tenantId])
  @@index([branchId])
  @@index([tableId])
  @@index([tenantId, branchId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, branchId, status])
  @@index([tableId, status])
  @@index([cashierId, createdAt])
}

model RiderAssignment {
  id          String                   @id @default(cuid())
  tenantId    String
  orderId     String                   @unique
  riderId     String? // User with RIDER role
  status      DeliveryAssignmentStatus @default(UNASSIGNED)
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider  User?  @relation(fields: [riderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([riderId])
}

// Delivery zones are stored as a polygon in GeoJSON-like JSON (array of [lng,lat] pairs)
model DeliveryZone {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  polygon   Json // [[lng,lat],...]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([tenantId])
  @@index([branchId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  itemId  String

  quantity  Int
  unitPrice Float
  subtotal  Float
  notes     String?

  // Storing variations and addons as JSON to prevent historical price changes from affecting past orders
  options Json?

  // KDS per-item tracking â€” each line item can be tracked independently on the kitchen display
  kdsStationId String? // Which station is responsible for this item
  kdsStatus    KdsItemStatus @default(WAITING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item        Item          @relation(fields: [itemId], references: [id])
  kdsStation  KdsStation?   @relation(fields: [kdsStationId], references: [id], onDelete: SetNull)
  VoidRequest VoidRequest[]

  @@index([orderId])
  @@index([itemId])
  @@index([kdsStationId])
  @@index([kdsStatus])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  amount        Float
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(PENDING)
  transactionId String? // For online payments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// -----------------------------------------------------------------------------
// WHATSAPP AI ORDERING BOT
// -----------------------------------------------------------------------------

enum WhatsAppConversationStage {
  GREETING
  BROWSING_MENU
  BUILDING_ORDER
  COLLECTING_ORDER_TYPE
  COLLECTING_ADDRESS
  SELECTING_PAYMENT
  CONFIRMED
  COMPLETED
  ABANDONED
}

model WhatsAppConfig {
  id       String @id @default(cuid())
  tenantId String @unique

  isEnabled       Boolean @default(false)
  botName         String  @default("Assistant")
  botPersona      String?
  defaultBranchId String?

  // Meta WhatsApp Cloud API credentials
  metaPhoneNumberId String? // Used to route an inbound webhook to this tenant
  metaAccessToken   String? // Meta Graph API access token

  allowedOrderTypes String[] // subset of ["TAKEAWAY", "DELIVERY"]
  minOrderAmount    Float    @default(0)

  operatingHours     Json? // { monday: { open: "11:00", close: "23:00", isOpen: true }, ... }
  visibleCategoryIds String[] // empty = all categories visible

  // Stubbed for a future pass — no gateway integration yet, COD only
  jazzCashEnabled  Boolean @default(false)
  easyPaisaEnabled Boolean @default(false)

  awayMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WhatsAppConversation {
  id       String @id @default(cuid())
  tenantId String
  branchId String

  customerId   String?
  phoneNumber  String
  customerName String?

  stage WhatsAppConversationStage @default(GREETING)

  cartJson  Json? // working cart before the real Order is created
  orderType OrderType?

  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?

  orderId String? // set once the real Order is created

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages WhatsAppMessage[]

  @@index([tenantId, phoneNumber])
  @@index([tenantId, stage])
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  direction      String // IN or OUT
  body           String?
  rawPayload     Json
  aiIntent       Json? // parsed intent, null when fallbackParse was used
  processedAt    DateTime?
  processError   String?
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId, createdAt])
}

model WhatsAppBlocklist {
  id          String   @id @default(cuid())
  tenantId    String
  phoneNumber String
  reason      String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phoneNumber])
}

// -----------------------------------------------------------------------------
// SHIFT MODELS
// -----------------------------------------------------------------------------

enum ShiftStatus {
  OPEN // Shift is active â€” terminal can process orders
  CLOSED // Shift has been closed and reconciled
  ABANDONED // Shift was left open with no activity for a long time
}

// A Shift represents one cashier's working session at a POS terminal.
// It tracks cash float in/out, total sales, and payment method breakdowns
// for end-of-day reconciliation.
model Shift {
  id       String @id @default(cuid())
  tenantId String
  branchId String
  userId   String // The cashier who opened the shift

  status ShiftStatus @default(OPEN)

  // Cash float provided to the cashier at shift open
  openingFloat Float @default(0)

  // Recorded at shift close â€” cashier's physical count of cash in drawer
  closingCash Float?

  // System-calculated totals (populated on close)
  totalSales    Float? // Sum of all completed order netAmounts during this shift
  totalCash     Float? // Sum of CASH payments
  totalCard     Float? // Sum of CARD payments
  totalDiscount Float? // Sum of discounts applied
  totalTax      Float? // Sum of tax collected
  totalOrders   Int? // Count of orders in this shift

  closedReason String? // Reason provided if FORCE_CLOSED_BY_MANAGER
  totalRefunds Float?  @default(0)

  // Variance = closingCash - (openingFloat + totalCash)
  // Positive = overage, Negative = shortage
  cashVariance Float?

  method    String?   @default("MANUAL") // ZKTECO or MANUAL
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  notes String? // Supervisor notes on close

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  cashEntries   ShiftCashEntry[]
  denominations ShiftDenomination[]
  orders        Order[]
  breaks        ShiftBreak[]
  activities    ShiftActivity[]

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([status])
}

// Tracks mid-shift cash-in / cash-out entries (e.g., safe drops, paid-outs)
model ShiftCashEntry {
  id      String @id @default(cuid())
  shiftId String

  type   ShiftCashEntryType
  amount Float
  reason String? // e.g., "Safe drop", "Paid out for supplies"

  createdAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

enum ShiftCashEntryType {
  CASH_IN // Money added to drawer (e.g., received change from safe)
  CASH_OUT // Money removed from drawer (e.g., safe drop, paid-out)
}

// Denomination breakdown entered by cashier at shift close
// e.g., 5 x Rs.1000, 10 x Rs.500, etc.
model ShiftDenomination {
  id      String @id @default(cuid())
  shiftId String

  denomination Float // Face value of the note/coin (e.g., 1000, 500, 100, 50, 20, 10, 5, 1)
  quantity     Int // Number of notes/coins of this denomination
  total        Float // denomination * quantity (denormalized for convenience)

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

// Tracks every break a cashier takes during a shift
model ShiftBreak {
  id      String @id @default(cuid())
  shiftId String

  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationMinutes Int? // Populated when the break ends
  reason          String?

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

// Immutable audit trail of everything that happens during a shift
model ShiftActivity {
  id      String @id @default(cuid())
  shiftId String

  activityType  ShiftActivityType
  occurredAt    DateTime          @default(now())
  performedById String? // userId of whoever triggered the action
  amount        Float? // For CASH_IN / CASH_OUT entries
  notes         String?
  metadata      Json? // Flexible payload (e.g. orderId, breakId)

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([activityType])
}

enum ShiftActivityType {
  OPENED
  BREAK_START
  BREAK_END
  CASH_IN
  CASH_OUT
  ORDER_COMPLETED
  ORDER_VOIDED
  DISCOUNT_APPLIED
  CLOSED
  FORCE_CLOSED
  FORCE_CLOSED_BY_MANAGER
}

// -----------------------------------------------------------------------------
// KDS STATION MODELS
// -----------------------------------------------------------------------------

// Per-item KDS tracking status (independent of the whole order status)
enum KdsItemStatus {
  WAITING // Item not yet acknowledged by any station
  IN_PROGRESS // Kitchen is working on this item
  DONE // Item is ready / plated
  VOIDED // Item was removed / cancelled
}

// A KdsStation is a physical kitchen display screen dedicated to a specific
// cooking area (e.g., Grill, Fryer, Cold Station, Drinks Bar).
// Each station displays only the items routed to it via KdsStationRoute.
model KdsStation {
  id       String @id @default(cuid())
  tenantId String
  branchId String

  name         String // e.g., "Grill", "Fryer", "Cold Station", "Drinks"
  color        String  @default("#f97316") // Accent color shown on the KDS screen header
  displayOrder Int     @default(0) // Controls column order on multi-station views
  isActive     Boolean @default(true)

  // Optional: if true, ALL new orders are routed here regardless of routing rules
  // Useful for small kitchens with a single KDS screen
  catchAll Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  routes     KdsStationRoute[] // Routing rules pointing to this station
  orderItems OrderItem[] // Items currently assigned to this station

  @@index([tenantId])
  @@index([branchId])
  @@index([isActive])
}

// KdsStationRoute maps menu categories or individual items to a KDS station.
// Routing priority: item-level rule > category-level rule > catch-all station.
//
// Examples:
//   { stationId: "grill-id",  categoryId: "burgers-id" }  â†’ All burgers â†’ Grill
//   { stationId: "fryer-id",  itemId: "fries-id" }         â†’ Fries item  â†’ Fryer
//   { stationId: "drinks-id", categoryId: "drinks-id" }   â†’ Drinks cat  â†’ Drinks bar
model KdsStationRoute {
  id        String @id @default(cuid())
  stationId String

  // Exactly one of categoryId or itemId must be set (enforced at app layer)
  categoryId String? // Route an entire menu category to this station
  itemId     String? // Route a specific menu item to this station

  priority Int @default(0) // Higher number = higher priority when multiple rules match

  createdAt DateTime @default(now())

  station  KdsStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  item     Item?      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([categoryId])
  @@index([itemId])
}

