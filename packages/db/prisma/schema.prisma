  @@index([tenantId])
  @@index([segment])
  @@index([deletedAt]) // To filter out deleted customers easily
}

model CustomerNote {
  id         String @id @default(cuid())
  customerId String
  tenantId   String
  staffName  String // Storing name directly for timeline display
  noteText   String

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model LoyaltyTier {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  minPoints  Int      @default(0)
  multiplier Float    @default(1) // points multiplier for earnings
  badgeColor String   @default("#FF5722")
  benefits   Json? // e.g., { "birthdayBonus": true, "prioritySeating": true, "freeItem": "item_id" }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([minPoints])
