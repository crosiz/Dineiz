// -----------------------------------------------------------------------------
// BRANDING / WHITE-LABEL SETTINGS (per-tenant)
// -----------------------------------------------------------------------------

model TenantBranding {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Restaurant identity
  restaurantName String  @default("")
  tagline        String?
  businessType   String  @default("Fine Dining")
  phone          String?
  website        String?

  // Visual branding
  logoUrl        String?
  primaryColor   String  @default("#FF5722")
  secondaryColor String  @default("#1A1A2E")
  accentColor    String  @default("#FFB300")

  // Custom domains
  customPosDomain     String?
  customConsoleDomain String?

  // POS Terminal Settings
  currency                    String  @default("PKR")
  posLanguage                 String  @default("en")
  requireShiftOpen            Boolean @default(true)
  autoKotPrint                Boolean @default(true)
  autoReceiptPrint            Boolean @default(true)
  blockOutOfStock             Boolean @default(true)
  allowCashierDiscounts       Boolean @default(false)
  maxDiscountPercent          Float   @default(0)
  discountLimit               Float   @default(0)
  voidRequiresManagerApproval Boolean @default(true)
  
  kotEnabled                  Boolean @default(true)
  posMarkReadyEnabled         Boolean @default(true)
  cashEnabled                 Boolean @default(true)
  cardEnabled                 Boolean @default(true)
  jazzcashEnabled             Boolean @default(false)
  easypaisaEnabled            Boolean @default(false)

  // Receipt / invoice
  receiptHeader      String?
  receiptFooter      String?
  showLogoOnReceipt  Boolean @default(true)
  showTaxBreakdown   Boolean @default(true)
  showTokenNumber    Boolean @default(false)
  showCashierName    Boolean @default(false)
  showTableNumber    Boolean @default(false)
  receiptLanguage    String  @default("English (US)")
  receiptPaperSize   String  @default("80mm")
  receiptLayout      String  @default("CLASSIC")
  downloadPdfReceipt Boolean @default(false)
  receiptCopies      Int     @default(1)

  // Payment toggles
  cashShowTendered Boolean @default(true)
  cashShowChange   Boolean @default(true)
  cardShowMethod   Boolean @default(true)
  showPoweredBy    Boolean @default(true)

  // FBR / Tax Integration
  fbrEnabled       Boolean @default(false)
  fbrNtn           String?
  fbrPosId         String?
  fbrInvoicePrefix String?
  fbrSrb           Boolean @default(false)
  taxAuthority     String  @default("FBR")

  // Tax configuration (legacy â€” kept for backward compatibility)
  taxMode              String  @default("EXCLUSIVE")
  dineinTaxRate        Float   @default(5) // @deprecated â€” use cashTaxRate
  takeawayTaxRate      Float   @default(0) // @deprecated â€” use cashTaxRate
  deliveryTaxRate      Float   @default(0) // @deprecated â€” use cashTaxRate
  serviceChargeEnabled Boolean @default(false)
  serviceChargeRate    Float   @default(10)

  // Dual Tax Configuration (FBR Compliant â€” Pakistan withholding tax)
  cashTaxEnabled       Boolean @default(true)
  cashTaxRate          Float   @default(5) // GST rate for cash payments (%)
  cashTaxLabel         String  @default("GST (Cash)")
  cardTaxEnabled       Boolean @default(true)
  cardTaxRate          Float   @default(17) // GST rate for card/digital payments (%)
  cardTaxLabel         String  @default("GST (Card/Digital)")
  showDualTaxOnReceipt Boolean @default(true) // Print both cash+card totals on pre-payment receipt
  cashTaxNote          String? // e.g. "Per FBR SRO 1125(I)/2019"
  cardTaxNote          String? // e.g. "Withholding tax applied"
  taxRoundingMethod    String  @default("ROUND") // ROUND, FLOOR, CEIL

  // Receipt advanced
  showFbrLogo       Boolean @default(true)
  showQrCode        Boolean @default(true)
  showNtn           Boolean @default(true)
  receiptDisclaimer String?
  cashPaymentNote   String?
  cardPaymentNote   String?

  // App icons / meta images
  faviconUrl String?
  appIconUrl String?
  ogImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// SUPER ADMIN & SUBSCRIPTION MANAGEMENT
// -----------------------------------------------------------------------------

model SuperAdmin {
  id          String         @id @default(cuid())
  email       String         @unique
  password    String
  name        String
  role        SuperAdminRole @default(SUPPORT)
  isActive    Boolean        @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  auditLogs AuditLog[]
  messages  SuperAdminMessage[]
}

model TenantSubscription {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               String    @default("STARTER") // FREE, PRO_GO, STARTER, PRO, ENTERPRISE
  billingCycle       String    @default("MONTHLY") // MONTHLY, ANNUAL
  status             String    @default("ACTIVE") // TRIALING, ACTIVE, PAST_DUE, CANCELLED
  amount             Float     @default(0) // MRR amount in PKR
  trialDays          Int       @default(14)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime  @default(now())
  nextRenewalDate    DateTime  @default(now())
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId])
}

model PaymentHistory {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String   @default("PKR")
  method      String   @default("BANK_TRANSFER") // BANK_TRANSFER, CREDIT_CARD, CASH
  reference   String?
  status      String   @default("PAID") // PAID, FAILED, PENDING
  description String
  notes       String?
  invoiceUrl  String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model TenantFeatureOverride {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureKey String
  enabled    Boolean  @default(true) // For boolean features
  limit      Int?     // For numeric limits (e.g. dailyOrders, branches)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, featureKey])
  @@index([tenantId])
}

model PlanDefinition {
  id          String   @id // e.g., GO_FREE, PRO
  name        String
  displayName String?
  price       Json     // e.g., { monthly: 0, annual: 0 }
  currency    String   @default("PKR")
  limits      Json     // e.g., { branches: 1, staff: 1, dailyOrders: 30, reportDaysHistory: 1 }
  features    Json     // boolean flags e.g., { mobileApp: true, tabletPOS: false, adminDashboard: false, ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SuperAdminMessage {
  id              String      @id @default(cuid())
  tenantId        String?
  tenant          Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  superAdminId    String?
  superAdmin      SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)
  channel         String      @default("EMAIL") // EMAIL, WHATSAPP, BOTH
  subject         String?
  body            String
  status          String      @default("SENT") // SENT, FAILED, DELIVERED, SCHEDULED
  recipientsCount Int         @default(1)
  targetSegment   String? // ALL_CLIENTS, PRO_ONLY, STARTER_ONLY, SPECIFIC
  openRate        Float?
  deliveryRate    Float?
  scheduledAt     DateTime?
  sentAt          DateTime    @default(now())
  createdAt       DateTime    @default(now())

  @@index([tenantId])
  @@index([superAdminId])
}

model AuditLog {
  id             String      @id @default(cuid())
  superAdminId   String?
  superAdmin     SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)
  action         String // PLAN_CHANGED, PAYMENT_ADDED, FEATURE_OVERRIDE, MESSAGE_SENT, ACCOUNT_SUSPENDED, ACCOUNT_RESUMED, TENANT_CREATED, TENANT_DELETED, SUPER_ADMIN_CREATED, SUPER_ADMIN_TOGGLED
  targetTenantId String?
  targetTenant   Tenant?     @relation(fields: [targetTenantId], references: [id], onDelete: SetNull)
  before         Json?
  after          Json?
  ipAddress      String?
  notes          String?
  createdAt      DateTime    @default(now())

  @@index([superAdminId])
  @@index([targetTenantId])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  minimumPlan String   @default("FREE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// ZKTECO BIOMETRIC ATTENDANCE
// -----------------------------------------------------------------------------

model ZktecoDevice {
  id         String            @id @default(cuid())
  tenantId   String
  branchId   String
  name       String // "Main Counter Machine"
  ipAddress  String
  port       Int               @default(4370)
  status     String            @default("OFFLINE") // ONLINE | OFFLINE
  lastSyncAt DateTime?
  createdAt  DateTime          @default(now())
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  punches    AttendancePunch[]

  @@index([tenantId, branchId])
}

model AttendancePunch {
  id          String       @id @default(cuid())
  tenantId    String
  branchId    String
  userId      String
  deviceId    String
  zkUserId    Int // the numeric ID enrolled on ZKTeco device
  punchTime   DateTime
  punchType   String // CLOCK_IN | CLOCK_OUT | BREAK_START | BREAK_END
  method      String // ZKTECO | MANUAL | WEBAUTHN
  isLate      Boolean      @default(false)
  lateMinutes Int          @default(0)
  shiftId     String?
  processedAt DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      ZktecoDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, punchTime])
  @@index([userId, punchTime])
}

model StaffZktecoEnrollment {
  id         String   @id @default(cuid())
  userId     String   @unique
  deviceId   String
  zkUserId   Int // numeric ID on the ZKTeco device
  enrolledAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceId, zkUserId])
}

enum VoidRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model VoidRequest {
  id          String            @id @default(cuid())
  tenantId    String
  branchId    String
  orderId     String
  orderItemId String
  cashierId   String
  quantity    Int
  reason      String
  status      VoidRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  cashier   User      @relation(fields: [cashierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// UNIFIED DEALS AND PROMOTIONS MODULE
// -----------------------------------------------------------------------------

enum DealType {
  PERCENT
  FIXED
  BUY_X_GET_Y
  HAPPY_HOUR
  FREE_ITEM
  COMBO_PRICE
}

model Deal {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  type        DealType

  // JSON configuration tailored to the specific DealType
  config Json

  // Conditions
  minOrderValue        Float?
  maxUsesTotal         Int?
  maxUsesPerCustomer   Int?
  validFrom            DateTime?
  validUntil           DateTime?
  validTimeStart       String? // e.g. "14:00"
  validTimeEnd         String? // e.g. "17:00"
  validDaysOfWeek      Int[] // [1,2,3,4,5,6,7]
  orderTypeRestriction String[] // ["DINE_IN", "TAKEAWAY", "DELIVERY"]
  branchIds            String[] // empty means all branches

  // POS Behavior
  autoApply               Boolean @default(false)
  requiresManagerApproval Boolean @default(false)
  showNameOnReceipt       Boolean @default(true)
  allowStacking           Boolean @default(false)

  // Promo code
  requiresPromoCode      Boolean @default(false)
  promoCode              String?
  promoCodeCaseSensitive Boolean @default(false)

  isActive  Boolean @default(true)
  usedCount Int     @default(0)
  version   Int     @default(1) // For optimistic locking

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderDeals OrderDeal[]

  // A Postgres partial index is ideal here, but Prisma doesn't fully support partial unique indexes easily
  // We'll rely on app-level unique validation for non-null promo codes if needed, or just standard index.
  @@index([tenantId, promoCode])
  @@index([tenantId])
  @@index([isActive])
  @@index([deletedAt])
}

model OrderDeal {
  id              String  @id @default(cuid())
  orderId         String
  dealId          String?
  dealName        String
  dealType        String
  discountApplied Float
  promoCodeUsed   String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deal  Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([dealId])
}

// -----------------------------------------------------------------------------
// CUSTOMER RELATIONSHIP MANAGEMENT (CRM) MODULE
// -----------------------------------------------------------------------------

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportStatus {
  ACTIVE
  PAUSED
}

model ScheduledReport {
  id             String          @id @default(cuid())
  tenantId       String
  branchId       String?
  name           String
  reportType     String
  parameters     Json
  format         ReportFormat
  frequency      ReportFrequency
  runAtTime      String // e.g., '09:00'
  recipients     String[]
  whatsappNumber String?
  status         ReportStatus    @default(ACTIVE)

  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastFileUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([nextRunAt])
}

// -----------------------------------------------------------------------------
// ANOMALIES DETECTION MODULE
// -----------------------------------------------------------------------------

enum AnomalyType {
  EXCESSIVE_VOIDS
  LARGE_DISCOUNT
  UNAUTHORIZED_DISCOUNT
  CASH_VARIANCE
  AFTER_HOURS_ORDER
  DELETED_KITCHEN_ITEM
  PRICE_MISMATCH
  DUPLICATE_ORDER
  REFUND_SPIKE
  ZERO_VALUE_ORDER
  ROUND_NUMBER_CASH
  SPLIT_ORDER_SUSPICIOUS
  HIGH_FREQUENCY_VOIDS
  LOW_STOCK
  STOCK_DISCREPANCY
  NEGATIVE_STOCK_SALE
  WASTAGE_EXCEEDS_STOCK
  EXPIRED_INGREDIENT
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnomalyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE
}

model AnomalyEvent {
  id               String          @id @default(cuid())
  tenantId         String
  branchId         String
  type             AnomalyType
  severity         AnomalySeverity
  description      String
  affectedEntityId String?
  affectedUserId   String?
  detectedAt       DateTime        @default(now())
  status           AnomalyStatus   @default(OPEN)
  resolutionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  affectedUser User?   @relation(fields: [affectedUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@index([type])
  @@index([status])
  @@index([detectedAt])
}

model AnomalySettings {
  id             String  @id @default(cuid())
  tenantId       String  @unique
  thresholds     Json
  toggles        Json
  notifyPush     Boolean @default(true)
  notifyEmail    Boolean @default(false)
  notifyWhatsapp Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

