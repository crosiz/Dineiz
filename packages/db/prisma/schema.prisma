model Customer {
  id                     String    @id @default(cuid())
  tenantId               String
  name                   String
  phone                  String?
  email                  String?
  birthDate              DateTime?
  anniversary            DateTime?
  notes                  String? // Internal notes
  tags                   String[] // E.g., "corporate client", "vip host"
  preferredPaymentMethod String?
  preferredOrderType     String?

  // Auto-calculated CRM metrics
  totalOrders   Int       @default(0)
  totalSpend    Float     @default(0)
  lastVisitAt   DateTime?
  loyaltyPoints Float     @default(0)
  currentTierId String?
  segment       String? // VIP, REGULAR, NEW, AT_RISK, LOST (updated nightly)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // GDPR/PDPA compliance (soft delete, scrub PII)

