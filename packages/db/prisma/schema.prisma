  tenantId   String
  customerId String
  type       LoyaltyPointType
  points     Int
  reference  String? // e.g. orderId
  note       String?
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([type])
  @@index([createdAt])
}

model LoyaltySettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  isActive           Boolean  @default(false)
  baseEarnRatePoints Float    @default(1)
  baseEarnRateSpend  Float    @default(10)
  minOrderValue      Float    @default(0)
  allowedOrderTypes  String[] // ["DINE_IN", "TAKEAWAY", "DELIVERY"]
  isolateBranches    Boolean  @default(false)

  expiryType      String    @default("MONTHS") // MONTHS or FIXED_DATE
  expiryMonths    Int       @default(12)
  expiryFixedDate DateTime?

  minPointsToRedeem                 Int     @default(100)
  redemptionValuePoints             Int     @default(100)
  redemptionValuePkr                Float   @default(10)
  maxRedemptionPercent              Float? // e.g. 50 for 50% of order
  maxRedemptionFlat                 Float?
  requireFullPaymentBeforeRedeeming Boolean @default(false)

  tierRecalculationMethod String @default("LIFETIME") // LIFETIME or MONTHLY

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LoyaltyCategoryMultiplier {
  id         String @id @default(cuid())
  tenantId   String
  categoryId String
  multiplier Float

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
