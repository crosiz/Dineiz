enum WebhookStatus {
  ACTIVE
  FAILING
  DISABLED
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  webhookId       String
  event           String
  payload         String   @db.Text
  requestHeaders  String   @db.Text
  responseStatus  Int?
  responseBody    String?  @db.Text
  responseTime    Int?     // in ms
  triggeredAt     DateTime @default(now())

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
}

model ZapierWebhookSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  event     String // e.g. "order.created", "order.updated", "order.delivered"
  url       String
  secret    String? // optional shared secret sent as header
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastStatus      WebhookDeliveryStatus?
  lastError       String?
  lastDeliveredAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([event])
  @@index([isActive])
}

model ErpIntegration {
  id        String      @id @default(cuid())
  tenantId  String      @unique
  provider  ErpProvider
  baseUrl   String?
  apiKey    String?
  enabled   Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // High-water mark for incremental sync
  lastSyncedAt DateTime?
  lastError    String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([provider])
}

// -----------------------------------------------------------------------------
// FLOOR PLAN MODELS (Task Designer)
// -----------------------------------------------------------------------------

model FloorPlan {
  id        String   @id @default(cuid())
  branchId  String   @unique
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floors    Json // array of FloorData objects
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Table {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label       String // "T1", "T2", "VIP-1", "Bar 3"
  capacity    Int // how many people can sit
  shape       String // "round" | "square" | "rectangle" | "booth"
  floorNumber Int      @default(1)
  positionX   Float // saved position on canvas
  positionY   Float
  width       Float
  height      Float
  rotation    Float    @default(0)
  isActive    Boolean  @default(true)
  status      String   @default("free") // "free", "occupied", "dirty", "ready", "reserved"
  orders      Order[] // active orders on this table
  createdAt   DateTime @default(now())

  @@index([branchId])
  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// BRANCH AVAILABILITY & MENU SCOPING
