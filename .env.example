# .env.example
# Note: NEXT_PUBLIC_API_URL is used by the browser (outside Docker) and should point to localhost.
# INTERNAL_API_URL is used by Next.js server components (inside Docker) and should use the internal Docker service name.

DATABASE_URL=
DIRECT_URL=
REDIS_URL=
MEILI_MASTER_KEY=
MEILI_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=
NEXT_PUBLIC_POS_URL=
NEXT_PUBLIC_DASHBOARD_URL=

# Task 85: Aggregator relay secret (shared between api and aggregator-bridge)
BRIDGE_SECRET=

# Task 86: ERP integration (stored in DB; these are optional defaults)
ERP_DEFAULT_PROVIDER=ERPNEXT
ERP_DEFAULT_BASE_URL=
ERP_DEFAULT_API_KEY=
